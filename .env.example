# Copy this file to `.env` and fill in the values you need.
# Any variable you leave out falls back to its default (see below).

# Port the server (Next.js + Colyseus) listens on. Default: 3000.
PORT=3000

# Public site URL, used for metadata and sharing. Default: http://localhost:3000
SITE_URL=http://localhost:3000

# Credentials for the Colyseus dashboard (/admin).
# When left empty, a random UUID is generated on every boot (so the
# credentials change on each restart).
MONITOR_USER=
MONITOR_PASSWORD=

# Umami analytics (self-hosted).
# Leaving the website ID empty disables Umami entirely (no script is loaded).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Umami script URL. Default: https://stats.may-baptiste.fr/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://stats.may-baptiste.fr/script.js
