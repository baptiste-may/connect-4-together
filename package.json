{
  "name": "connect-4-together",
  "version": "1.0.8",
  "private": true,
  "scripts": {
    "dev": "nodemon src/main.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx src/main.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@colyseus/monitor": "^0.18.6",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/ws-transport": "^0.18.4",
    "@faker-js/faker": "^10.6.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.3.8",
    "@next/third-parties": "^16.3.8",
    "colyseus": "^0.18.9",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "leo-profanity": "^1.9.0",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-daisyui": "^5.0.5",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/leo-profanity": "^1.5.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^4.12.24",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "esbuild",
    "msgpackr-extract",
    "sharp",
    "unrs-resolver"
  ],
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,css,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "bun@1.4.2"
}
