{
  "name": "connect-4-together",
  "version": "1.0.8",
  "private": true,
  "scripts": {
    "dev": "nodemon src/main.ts",
    "build": "next build",
    "build:cf": "NEXT_OUTPUT=export next build",
    "start": "NODE_ENV=production tsx src/main.ts",
    "dev:cf": "bun run build:cf && wrangler dev",
    "deploy:cf": "bun run build:cf && wrangler deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js && NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/monitor": "^0.18.6",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/ws-transport": "^0.18.4",
    "@faker-js/faker": "^10.6.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.3.8",
    "@next/third-parties": "^16.3.8",
    "colyseus": "^0.18.9",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "leo-profanity": "^1.9.0",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-daisyui": "^5.0.5",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@colyseus/testing": "^0.18.6",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/express": "^5.0.6",
    "@types/jest": "^30",
    "@types/leo-profanity": "^1.5.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^4.12.24",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jest": "^30",
    "jest-environment-jsdom": "^30",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29",
    "typescript": "^5.9.3",
    "wrangler": "^4.148.0"
  },
  "trustedDependencies": [
    "esbuild",
    "msgpackr-extract",
    "sharp",
    "simple-git-hooks",
    "unrs-resolver",
    "workerd"
  ],
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,css,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "bun@1.4.2"
}
