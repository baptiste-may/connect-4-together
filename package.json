{
  "name": "connect-4-together",
  "version": "1.0.7",
  "private": true,
  "scripts": {
    "dev": "nodemon src/main.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx src/main.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@colyseus/monitor": "^0.15.8",
    "@colyseus/schema": "^2.0.37",
    "@colyseus/ws-transport": "^0.15.3",
    "@faker-js/faker": "^10.5.0",
    "@next/mdx": "^15.5.7",
    "@next/third-parties": "^15.5.7",
    "@types/express": "^5.0.6",
    "@types/leo-profanity": "^1.5.5",
    "@types/mdx": "^2.0.13",
    "@types/underscore": "^1.13.0",
    "colyseus": "^0.15.57",
    "colyseus.js": "^0.15.28",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-basic-auth": "^1.2.1",
    "leo-profanity": "^1.8.0",
    "lucide-react": "^0.513.0",
    "next": "^15.5.24",
    "react": "^19.2.1",
    "react-daisyui": "^5.0.5",
    "react-dom": "^19.2.1",
    "tsx": "^4.21.0",
    "underscore": "^1.13.8",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "daisyui": "^4.12.24",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.24",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.25",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "esbuild",
    "msgpackr-extract",
    "sharp",
    "unrs-resolver"
  ],
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,css,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "bun@1.3.10"
}
